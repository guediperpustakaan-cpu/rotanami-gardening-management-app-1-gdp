# Salin file ini menjadi .env lalu isi nilainya.
# Jangan menaruh rahasia di kode frontend; variabel ini hanya dibaca sisi server.

# String koneksi PostgreSQL / Neon.
# Contoh lokal:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Contoh Neon (ganti dengan connection string dari dashboard Neon Anda):
# DATABASE_URL=postgresql://namauser:KATA_SANDI@ep-xxxxx.us-east-2.aws.neon.tech/namadb?sslmode=require
